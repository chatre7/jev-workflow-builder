# Single-owner sign-in. Use a unique, randomly generated password (16–256 chars).
# No GitHub account or OAuth App is required.
OWNER_PASSWORD=
NEXTAUTH_URL=http://localhost:3000
# Generate at least 32 random characters, distinct from OWNER_PASSWORD/API token.
NEXTAUTH_SECRET=
WORKFLOW_WORKSPACE_ID=private

# Shared login throttling and run admission, including mock AI runs.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional run-only bearer token for server-to-server API callers (32–256 chars).
# Never expose this as NEXT_PUBLIC_* or put it in browser code.
WORKFLOW_API_TOKEN=

# https://liveblocks.io/dashboard/apikeys
LIVEBLOCKS_SECRET_KEY=

# Optional. https://openrouter.ai/settings/keys — shared by Jev and LLM nodes.
# Without it, both use labeled mocks. Jev models consume OpenRouter credits.
OPENROUTER_API_KEY=

# Optional named server-only HTTPS connections; never use NEXT_PUBLIC_*.
# Methods default to GET. Add trusted endpoint credentials only in server headers.
# WORKFLOW_HTTP_CONNECTIONS='{"public-demo":{"baseUrl":"https://jsonplaceholder.typicode.com/","methods":["GET"]}}'
WORKFLOW_HTTP_CONNECTIONS=

# Optional lexical-search catalog. Ship/mount this JSON file on the server.
# The bundled catalog contains illustrative DEMO policies, not real business rules.
# WORKFLOW_KNOWLEDGE_FILE=examples/knowledge.json
WORKFLOW_KNOWLEDGE_FILE=
