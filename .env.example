# GitHub OAuth App callback: <NEXTAUTH_URL>/api/auth/callback/github
# All allowlisted GitHub accounts share this deployment's private workspace.
GITHUB_ID=
GITHUB_SECRET=
GITHUB_ALLOWED_USERS=chatre7
NEXTAUTH_URL=http://localhost:3000
# Generate at least 32 random characters. Never reuse the API token below.
NEXTAUTH_SECRET=
WORKFLOW_WORKSPACE_ID=private

# Shared run admission is required, including for mock AI runs.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional run-only bearer token for server-to-server API callers (32–256 chars).
# Never expose this as NEXT_PUBLIC_* or put it in browser code.
WORKFLOW_API_TOKEN=

# https://liveblocks.io/dashboard/apikeys
LIVEBLOCKS_SECRET_KEY=

# Optional. https://console.typesafe.ai — without it, Jev nodes run against a
# deterministic mock that picks answers by keyword overlap.
TYPESAFE_API_KEY=

# Optional. https://vercel.com/docs/ai-gateway — without it, LLM nodes stream a
# canned mock reply.
AI_GATEWAY_API_KEY=
